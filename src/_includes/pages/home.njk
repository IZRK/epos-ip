<main id="main-content">
  <section class="home-hero">
    <img class="home-hero__image" src="/assets/images/home-hero.webp" width="1600" height="1066" alt="Škocjan Caves karst landscape" fetchpriority="high">
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="home-hero__content shell">
      <p class="eyebrow">European Plate Observing System</p>
      <h1>EPOS Slovenia</h1>
      <p>Research data, services and facilities for solid Earth science.</p>
      <div class="button-row">
        <a class="button button--primary" href="/data-sites/">Explore data &amp; sites</a>
        <a class="button button--light" href="/epos-slovenia/">EPOS in Slovenia</a>
      </div>
    </div>
  </section>

  <section class="home-introduction section-shell shell">
    <div class="section-heading-block">
      <p class="eyebrow">Connected Earth science</p>
      <h2>Understanding a dynamic planet</h2>
    </div>
    <div class="wp-content home-copy">
      {{ sourcePage.contentHtml | structureHomeContent | safe }}
    </div>
  </section>

  <section class="home-pathways section-shell">
    <div class="shell">
      <div class="section-heading-block section-heading-block--row">
        <div>
          <p class="eyebrow">Discover EPOS Slovenia</p>
          <h2>Infrastructure, research and results</h2>
        </div>
      </div>
      <div class="pathway-grid">
        <a class="pathway-card pathway-card--map" href="/data-sites/">
          <span class="pathway-card__number">01</span>
          <h3>Data &amp; Sites</h3>
          <p>Research stations, observatories, maps and data portals.</p>
          <span class="text-link">View data &amp; sites <span aria-hidden="true">→</span></span>
        </a>
        <a class="pathway-card" href="/partners/">
          <span class="pathway-card__number">02</span>
          <h3>National partners</h3>
          <p>Five institutions contributing expertise and infrastructure.</p>
          <span class="text-link">Meet the partners <span aria-hidden="true">→</span></span>
        </a>
        <a class="pathway-card" href="/publications-sp/">
          <span class="pathway-card__number">03</span>
          <h3>Publications</h3>
          <p>Research outputs from the EPOS Slovenia community.</p>
          <span class="text-link">Browse publications <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  {% set latestNews = siteContent.pages | pageByUrl('/events/') %}
  {% if latestNews and latestNews.newsGroups.length %}
    <section class="latest-news section-shell shell">
      <div class="section-heading-block section-heading-block--row">
        <div>
          <p class="eyebrow">Latest activity</p>
          <h2>News from EPOS Slovenia</h2>
        </div>
        <a class="text-link" href="/events/">All news <span aria-hidden="true">→</span></a>
      </div>
      <div class="latest-news__grid">
        {% for item in latestNews.newsGroups[0].items %}
          {% if loop.index <= 3 %}
            <article class="news-preview">
              <span class="news-preview__year">{{ latestNews.newsGroups[0].year }}</span>
              <p>{{ item.text | excerpt(220) }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="fieldwork-gallery section-shell" aria-labelledby="fieldwork-gallery-title">
    <div class="shell">
      <div class="section-heading-block section-heading-block--row">
        <div>
          <p class="eyebrow">Fieldwork and observatories</p>
          <h2 id="fieldwork-gallery-title">EPOS Slovenia in the field</h2>
        </div>
        <p class="section-intro">Research sites, instruments and field campaigns across Slovenia.</p>
      </div>
    </div>
    <div class="fieldwork-gallery__track shell" role="list" aria-label="EPOS Slovenia fieldwork gallery">
      {% for image in sourcePage.heroImages %}
        <figure class="fieldwork-gallery__item" role="listitem">
          <img src="{{ image.src }}" alt="{{ image.alt }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}" decoding="async">
        </figure>
      {% endfor %}
    </div>
  </section>
</main>
