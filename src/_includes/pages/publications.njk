{% set heroLead = 'Research outputs from the EPOS Slovenia community, organized by year.' %}
{% include "components/page-hero.njk" %}
<main id="main-content" class="main-content">
  <div class="publication-summary shell">
    <p><strong>{{ sourcePage.publicationCount }}</strong> publications and research outputs</p>
  </div>
  <div class="archive-layout shell">
    <aside class="archive-nav" aria-label="Publication years">
      <p class="archive-nav__title">Browse by year</p>
      <ol>
        {% for group in sourcePage.publicationGroups %}
          <li><a href="#year-{{ group.year }}">{{ group.year }} <span>{{ group.items.length }}</span></a></li>
        {% endfor %}
      </ol>
    </aside>
    <div class="publication-archive">
      {% for group in sourcePage.publicationGroups %}
        <section class="publication-year" id="year-{{ group.year }}" aria-labelledby="publication-year-{{ group.year }}">
          <header class="publication-year__header">
            <h2 id="publication-year-{{ group.year }}">{{ group.year }}</h2>
            <span>{{ group.items.length }}</span>
          </header>
          <div class="publication-list">
            {% for item in group.items %}
              <article class="publication-card">
                <p>{{ item.html | safe }}</p>
              </article>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    </div>
  </div>
</main>
